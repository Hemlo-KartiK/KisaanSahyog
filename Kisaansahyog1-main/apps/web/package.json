{
  "name": "@kisaansahyog/web",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first KisaanSahyog PWA built with Vite, React, Tailwind CSS, and Zustand.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kisaansahyog/shared": "*",
    "lucide-react": "^1.61.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
